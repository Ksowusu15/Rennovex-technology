# Public URLs
APP_URL="https://your-domain.com"
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Neon PostgreSQL (pooled app URL + direct migration URL)
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-POOLER-HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-DIRECT-HOST/neondb?sslmode=require"

# Authentication
AUTH_SECRET="replace-with-a-long-random-secret"
ADMIN_NAME="Super Administrator"
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD="replace-before-seeding"

# Resend (used for password resets, contact mail, and optional new-device login alerts)
RESEND_API_KEY="re_..."
ADMIN_FROM_EMAIL="Rennovex Admin <admin@your-domain.com>"
CONTACT_FROM_EMAIL="Rennovex Website <website@your-domain.com>"
CONTACT_NOTIFICATION_EMAIL="hello@your-domain.com"

# Cloudinary (server-side only)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Neon connection guidance
# DATABASE_URL should use the pooled hostname containing "-pooler".
# Recommended query parameters for local/serverless reliability:
# ?sslmode=require&channel_binding=require&connection_limit=5&pool_timeout=20&connect_timeout=15
# DIRECT_URL should use the direct hostname without "-pooler" and is used for migrations.

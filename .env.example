# Keep actual secrets in .env locally and Vercel Environment Variables.
# Runtime: pooled Neon connection; migrations: direct connection.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Replace with your existing HTTPS domain; use preview-specific values in Preview.
APP_URL="https://your-existing-domain.example"
NEXT_PUBLIC_SITE_URL="https://your-existing-domain.example"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

RESEND_API_KEY=""
ADMIN_FROM_EMAIL=""
# Client invitations and resets; falls back to ADMIN_FROM_EMAIL.
RESEND_FROM_EMAIL=""
CONTACT_FROM_EMAIL=""
# Team inbox for enquiries, bookings, quotes and client support.
# Defaults to the Rennovex company inbox when empty.
CONTACT_NOTIFICATION_EMAIL="rennovextechnology@gmail.com"
# Authorizes the notification retry worker. Use a separate random secret.
CRON_SECRET=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Only for intentionally creating seed accounts; not required for normal runtime.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Rennovex Administrator"
